diff --git a/resources/modgui/stylesheet-nam.css b/resources/modgui/stylesheet-nam.css
index 7f9632b..54f7cc4 100644
--- a/resources/modgui/stylesheet-nam.css
+++ b/resources/modgui/stylesheet-nam.css
@@ -128,3 +128,152 @@
 .mod-pedal-nam .mod-enumerated .mod-enumerated-list > div.selected:hover {
     background: #555;
 }
+
+
+/* = PANNEAU DE REGLAGES (gabarit settings.html)
+================================================
+   Ce bloc avait ete PERDU en restaurant la feuille de style d'origine depuis
+   le depot : sans lui, le gabarit s'affiche sans grille ni ordre, les listes
+   restent deployees et se recouvrent, et les clics n'atteignent plus les
+   fichiers. */
+.x-set{{{cns}}} .x-sec-grid {
+    display:flex;
+    flex-wrap:wrap;
+    align-items:flex-start;
+}
+.x-set{{{cns}}} .x-break { flex:0 0 100%; height:0; margin:0; }
+.x-set{{{cns}}} .x-line-title {
+    flex:0 0 100%;
+    font-size:11px;
+    letter-spacing:1px;
+    text-transform:uppercase;
+    color:#b08ad0;
+    padding:10px 0 4px 4px;
+    border-top:1px solid rgba(255,255,255,0.12);
+}
+
+/* Le selecteur de fichier de mod-ui est une LISTE DEROULEE EN PLACE, pas une
+   ligne qui s'ouvre. Vouloir la refermer et la faire flotter la faisait
+   deborder sur la ligne suivante. On lui donne donc une hauteur fixe, et le
+   defilement se fait A L'INTERIEUR. */
+.x-set{{{cns}}} .x-file {
+    flex:0 0 330px;
+    height:132px;
+    margin-right:10px !important;
+    overflow:hidden;
+    position:relative;
+}
+.x-set{{{cns}}} .x-file .mod-enumerated-selected {
+    padding:0 6px;
+    height:22px;
+    line-height:22px;
+    white-space:nowrap;
+    overflow:hidden;
+    text-overflow:ellipsis;
+    color:#fff;
+    font-size:11px;
+}
+.x-set{{{cns}}} .x-file .mod-enumerated-list {
+    position:static;
+    max-height:104px;
+    overflow-y:auto;
+    background:rgba(0,0,0,0.35);
+    border-radius:4px;
+}
+.x-set{{{cns}}} .x-file [mod-role="enumeration-option"] {
+    font-size:11px;
+    padding:3px 6px;
+    white-space:nowrap;
+    overflow:hidden;
+    text-overflow:ellipsis;
+    cursor:pointer;
+}
+.x-set{{{cns}}} .x-file [mod-role="enumeration-option"]:hover { background:#4a3a5a; color:#fff; }
+
+/* les cellules voisines s'alignent en haut de la ligne, pas au milieu */
+.x-set{{{cns}}} .x-sec-grid { align-items:flex-start; }
+
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#model"] { order:10; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav1"] { order:110; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav2"] { order:120; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav3"] { order:130; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav4"] { order:140; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav5"] { order:150; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav6"] { order:160; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav7"] { order:170; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav8"] { order:180; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav9"] { order:190; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav10"] { order:200; }
+
+
+/* = PEDALE : n'y montrer que le MODELE COURANT
+   Le gabarit d'origine boucle sur tous les parametres fichier ; avec dix
+   favoris cela faisait onze listes empilees qui debordaient du boitier.
+   Les favoris se reglent dans le panneau. */
+.mod-pedal-nam [mod-parameter-uri*="#fav"] { display:none !important; }
+
+/* = PANNEAU : borner TOUTES les listes, pas seulement celles de fichiers
+   Un widget enumere de mod-ui s'affiche deroule en place. Sans hauteur fixe,
+   les listes de noms recouvrent les lignes voisines. */
+.x-set{{{cns}}} .mod-enumerated {
+    height:132px;
+    overflow:hidden;
+    position:relative;
+}
+.x-set{{{cns}}} .mod-enumerated .mod-enumerated-list {
+    position:static;
+    max-height:100px;
+    overflow-y:auto;
+    background:rgba(0,0,0,0.35);
+    border-radius:4px;
+}
+.x-set{{{cns}}} .mod-enumerated [mod-role="enumeration-option"] {
+    font-size:11px;
+    padding:3px 6px;
+    white-space:nowrap;
+    overflow:hidden;
+    text-overflow:ellipsis;
+    cursor:pointer;
+}
+
+/* toutes les cellules d'une ligne font la meme hauteur, alignees en haut */
+
+
+/* Ne RIEN imposer aux cellules natives : mod-ui place ses etiquettes en absolu
+   a l'interieur, et une hauteur ou une largeur forcee les fait chevaucher le
+   bouton. On se contente de ne pas les laisser flotter. */
+.x-set{{{cns}}} .x-cell { float:none !important; position:relative; }
+
+/* Seules les listes sont bornees -- elles seules debordent. */
+.x-set{{{cns}}} .mod-enumerated { height:126px; overflow:hidden; }
+.x-set{{{cns}}} .mod-enumerated .mod-enumerated-list {
+    position:static;
+    max-height:96px;
+    overflow-y:auto;
+}
+
+
+/* Correction mesuree par l'auto-gain : une cellule etroite posee a cote de la
+   liste des noms. Le champ de saisie libre qui l'accompagnait a ete retire --
+   les noms se choisissent dans la liste. */
+.x-set{{{cns}}} .nam-mesure {
+    flex:0 0 110px;
+    height:126px;
+    padding-top:8px;
+    box-sizing:border-box;
+}
+.x-set{{{cns}}} .nam-mesure-title {
+    display:block;
+    font-size:10px;
+    color:#9a7fb8;
+    letter-spacing:1px;
+    text-transform:uppercase;
+    margin-bottom:6px;
+}
+.x-set{{{cns}}} .nam-auto {
+    display:block;
+    margin-top:6px;
+    font-size:11px;
+    color:#6e6e6e;
+}
+.x-set{{{cns}}} .nam-auto.nam-auto-vif { color:#8fd98f; }
