+    <div class="mod-knob x-cell" style="order:33"><span class="mod-knob-title">Gain hors favori</span><span class="mod-knob-min-value" mod-role="input-control-minimum" mod-port-symbol="fav_gain"></span><span class="mod-knob-max-value" mod-role="input-control-maximum" mod-port-symbol="fav_gain"></span><span class="mod-knob-current-value" mod-role="input-control-value" mod-port-symbol="fav_gain"></span><div class="mod-knob-background"></div><div class="mod-knob-image" mod-role="input-control-port" mod-port-symbol="fav_gain" mod-widget="film"></div><div class="mod-address {{#isPerformanceView}}mod-hidden{{/isPerformanceView}}" mod-role="input-control-address" mod-port-symbol="fav_gain"></div><span class="mod-knob-snapshot-status icon-camera" mod-role="input-control-snapshotable" mod-port-symbol="fav_gain"></span></div>
