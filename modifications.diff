diff --git a/resources/modgui/stylesheet-nam.css b/resources/modgui/stylesheet-nam.css
index 7f9632b..6b65d0a 100644
--- a/resources/modgui/stylesheet-nam.css
+++ b/resources/modgui/stylesheet-nam.css
@@ -128,3 +128,151 @@
 .mod-pedal-nam .mod-enumerated .mod-enumerated-list > div.selected:hover {
     background: #555;
 }
+
+
+/* = SETTINGS PANEL (the settings.html template)
+================================================
+   This block was once LOST while restoring the original stylesheet from the
+   repository: without it the template shows up with no grid and no order, the
+   lists stay unfolded and overlap each other, and clicks no longer reach the
+   files. */
+.x-set{{{cns}}} .x-sec-grid {
+    display:flex;
+    flex-wrap:wrap;
+    align-items:flex-start;
+}
+.x-set{{{cns}}} .x-break { flex:0 0 100%; height:0; margin:0; }
+.x-set{{{cns}}} .x-line-title {
+    flex:0 0 100%;
+    font-size:11px;
+    letter-spacing:1px;
+    text-transform:uppercase;
+    color:#b08ad0;
+    padding:10px 0 4px 4px;
+    border-top:1px solid rgba(255,255,255,0.12);
+}
+
+/* mod-ui's file picker is a LIST UNFOLDED IN PLACE, not a row that opens.
+   Trying to fold it up and float it made it spill onto the next row. So it
+   gets a fixed height, and the scrolling happens INSIDE it. */
+.x-set{{{cns}}} .x-file {
+    flex:0 0 330px;
+    height:132px;
+    margin-right:10px !important;
+    overflow:hidden;
+    position:relative;
+}
+.x-set{{{cns}}} .x-file .mod-enumerated-selected {
+    padding:0 6px;
+    height:22px;
+    line-height:22px;
+    white-space:nowrap;
+    overflow:hidden;
+    text-overflow:ellipsis;
+    color:#fff;
+    font-size:11px;
+}
+.x-set{{{cns}}} .x-file .mod-enumerated-list {
+    position:static;
+    max-height:104px;
+    overflow-y:auto;
+    background:rgba(0,0,0,0.35);
+    border-radius:4px;
+}
+.x-set{{{cns}}} .x-file [mod-role="enumeration-option"] {
+    font-size:11px;
+    padding:3px 6px;
+    white-space:nowrap;
+    overflow:hidden;
+    text-overflow:ellipsis;
+    cursor:pointer;
+}
+.x-set{{{cns}}} .x-file [mod-role="enumeration-option"]:hover { background:#4a3a5a; color:#fff; }
+
+/* neighbouring cells line up at the top of the row, not in the middle */
+.x-set{{{cns}}} .x-sec-grid { align-items:flex-start; }
+
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#model"] { order:10; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav1"] { order:110; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav2"] { order:120; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav3"] { order:130; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav4"] { order:140; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav5"] { order:150; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav6"] { order:160; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav7"] { order:170; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav8"] { order:180; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav9"] { order:190; }
+.x-set{{{cns}}} .x-file[mod-parameter-uri$="#fav10"] { order:200; }
+
+
+/* = THE PEDAL: show nothing there but the CURRENT MODEL
+   The original template loops over every file parameter; with ten favorites
+   that made eleven stacked lists spilling out of the box. The favorites are
+   set in the panel. */
+.mod-pedal-nam [mod-parameter-uri*="#fav"] { display:none !important; }
+
+/* = PANEL: bound EVERY list, not only the file ones
+   A mod-ui enumerated widget shows up unfolded in place. With no fixed height
+   the name lists cover the neighbouring rows. */
+.x-set{{{cns}}} .mod-enumerated {
+    height:132px;
+    overflow:hidden;
+    position:relative;
+}
+.x-set{{{cns}}} .mod-enumerated .mod-enumerated-list {
+    position:static;
+    max-height:100px;
+    overflow-y:auto;
+    background:rgba(0,0,0,0.35);
+    border-radius:4px;
+}
+.x-set{{{cns}}} .mod-enumerated [mod-role="enumeration-option"] {
+    font-size:11px;
+    padding:3px 6px;
+    white-space:nowrap;
+    overflow:hidden;
+    text-overflow:ellipsis;
+    cursor:pointer;
+}
+
+/* every cell in a row shares the same height, aligned to the top */
+
+
+/* Impose NOTHING on the native cells: mod-ui places its labels absolutely
+   inside them, and a forced height or width makes them overlap the knob. We
+   settle for simply not letting them float. */
+.x-set{{{cns}}} .x-cell { float:none !important; position:relative; }
+
+/* Only the lists are bounded -- they are the only ones that spill. */
+.x-set{{{cns}}} .mod-enumerated { height:126px; overflow:hidden; }
+.x-set{{{cns}}} .mod-enumerated .mod-enumerated-list {
+    position:static;
+    max-height:96px;
+    overflow-y:auto;
+}
+
+
+/* The correction measured by the auto-gain: a narrow cell set beside the name
+   list. The free-text field that used to go with it has been removed -- names
+   are picked from the list. */
+.x-set{{{cns}}} .nam-measured {
+    flex:0 0 110px;
+    height:126px;
+    padding-top:8px;
+    box-sizing:border-box;
+}
+.x-set{{{cns}}} .nam-measured-title {
+    display:block;
+    font-size:10px;
+    color:#9a7fb8;
+    letter-spacing:1px;
+    text-transform:uppercase;
+    margin-bottom:6px;
+}
+.x-set{{{cns}}} .nam-auto {
+    display:block;
+    margin-top:6px;
+    font-size:11px;
+    color:#6e6e6e;
+}
+.x-set{{{cns}}} .nam-auto.nam-auto-live { color:#8fd98f; }
