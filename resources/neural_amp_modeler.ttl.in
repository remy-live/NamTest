@prefix atom:  <http://lv2plug.in/ns/ext/atom#>.
@prefix doap:  <http://usefulinc.com/ns/doap#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix lv2:   <http://lv2plug.in/ns/lv2core#>.
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#>.
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#>.
@prefix units: <http://lv2plug.in/ns/extensions/units#>.
@prefix urid:  <http://lv2plug.in/ns/ext/urid#>.
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#>.
@prefix patch: <http://lv2plug.in/ns/ext/patch#>.
@prefix state: <http://lv2plug.in/ns/ext/state#>.
@prefix work:  <http://lv2plug.in/ns/ext/worker#>.
@prefix mod: <http://moddevices.com/ns/mod#>.
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#>.

<@NAM_LV2_ID@#model>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Neural Model";
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav1>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 1 Model";
	pg:group <@NAM_LV2_ID@#groupe1>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav2>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 2 Model";
	pg:group <@NAM_LV2_ID@#groupe2>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav3>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 3 Model";
	pg:group <@NAM_LV2_ID@#groupe3>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav4>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 4 Model";
	pg:group <@NAM_LV2_ID@#groupe4>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav5>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 5 Model";
	pg:group <@NAM_LV2_ID@#groupe5>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav6>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 6 Model";
	pg:group <@NAM_LV2_ID@#groupe6>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav7>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 7 Model";
	pg:group <@NAM_LV2_ID@#groupe7>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav8>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 8 Model";
	pg:group <@NAM_LV2_ID@#groupe8>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav9>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 9 Model";
	pg:group <@NAM_LV2_ID@#groupe9>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#fav10>
	a lv2:Parameter;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel";
	rdfs:label "Fav 10 Model";
	pg:group <@NAM_LV2_ID@#groupe10>;
	rdfs:range atom:Path.

<@NAM_LV2_ID@#groupe1>
	a pg:InputGroup;
	lv2:name "Fav 1";
	lv2:symbol "fav1_group".

<@NAM_LV2_ID@#groupe2>
	a pg:InputGroup;
	lv2:name "Fav 2";
	lv2:symbol "fav2_group".

<@NAM_LV2_ID@#groupe3>
	a pg:InputGroup;
	lv2:name "Fav 3";
	lv2:symbol "fav3_group".

<@NAM_LV2_ID@#groupe4>
	a pg:InputGroup;
	lv2:name "Fav 4";
	lv2:symbol "fav4_group".

<@NAM_LV2_ID@#groupe5>
	a pg:InputGroup;
	lv2:name "Fav 5";
	lv2:symbol "fav5_group".

<@NAM_LV2_ID@#groupe6>
	a pg:InputGroup;
	lv2:name "Fav 6";
	lv2:symbol "fav6_group".

<@NAM_LV2_ID@#groupe7>
	a pg:InputGroup;
	lv2:name "Fav 7";
	lv2:symbol "fav7_group".

<@NAM_LV2_ID@#groupe8>
	a pg:InputGroup;
	lv2:name "Fav 8";
	lv2:symbol "fav8_group".

<@NAM_LV2_ID@#groupe9>
	a pg:InputGroup;
	lv2:name "Fav 9";
	lv2:symbol "fav9_group".

<@NAM_LV2_ID@#groupe10>
	a pg:InputGroup;
	lv2:name "Fav 10";
	lv2:symbol "fav10_group".

<@NAM_LV2_ID@#groupe0>
	a pg:InputGroup;
	lv2:name "AAA Navigation";
	lv2:symbol "nav_group".

<@NAM_LV2_ID@>
	a lv2:Plugin, lv2:SimulatorPlugin, mod:ControlVoltagePlugin, doap:Project;
	doap:name "Neural Amp Modeler";
	lv2:project <@NAM_LV2_ID@>;
	lv2:minorVersion @PROJECT_VERSION_MINOR@;
	lv2:microVersion @PROJECT_VERSION_PATCH@;
	doap:license <http://opensource.org/licenses/gpl-3-0>;

	doap:maintainer [
		foaf:name "Mike Oliphant";
		foaf:homepage <http://github.com/mikeoliphant>;
	];

	lv2:requiredFeature urid:map, work:schedule;
	lv2:optionalFeature lv2:hardRTCapable, opts:options, state:threadSafeRestore,
		<http://moddevices.com/ns/hmi#WidgetControl>,
		<http://kx.studio/ns/lv2ext/control-input-port-change-request>;
	lv2:extensionData work:interface, state:interface, opts:interface,
		<http://moddevices.com/ns/hmi#PluginNotification>;
	opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#maxBlockLength>;

	rdfs:comment """
LV2 plugin for neural network machine learning guitar amplifier simulation models

Models supported:
  Neural Amp Modeler (NAM): https://github.com/sdatkinson/neural-amp-modeler
  RTNeural keras/Aida-x models: https://github.com/jatinchowdhury18/RTNeural

A large collection of models is available at https://www.tone3000.com
""";

	patch:writable <@NAM_LV2_ID@#model>,
		<@NAM_LV2_ID@#fav1>,
		<@NAM_LV2_ID@#fav2>,
		<@NAM_LV2_ID@#fav3>,
		<@NAM_LV2_ID@#fav4>,
		<@NAM_LV2_ID@#fav5>,
		<@NAM_LV2_ID@#fav6>,
		<@NAM_LV2_ID@#fav7>,
		<@NAM_LV2_ID@#fav8>,
		<@NAM_LV2_ID@#fav9>,
		<@NAM_LV2_ID@#fav10>;

	# Control
	lv2:port [
		a atom:AtomPort, lv2:InputPort;
		atom:bufferType atom:Sequence;
		atom:supports patch:Message;
		lv2:designation lv2:control;
		lv2:index 0;
		lv2:symbol "control";
		lv2:name "Control"
	], [
		a atom:AtomPort, lv2:OutputPort;
		atom:bufferType atom:Sequence;
		atom:supports patch:Message;
		lv2:designation lv2:control;
		lv2:index 1;
		lv2:symbol "notify";
		lv2:name "Notify"
	];

	# Audio Ports
	lv2:port [
		a lv2:InputPort, lv2:AudioPort;
		lv2:index 2;
		lv2:symbol "input";
		lv2:name "Input";
	], [
		a lv2:OutputPort, lv2:AudioPort;
		lv2:index 3;
		lv2:symbol "output";
		lv2:name "Output";
	];

	# Parameters
	lv2:port [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 4;
		lv2:symbol "input_level";
		lv2:name "Input Lvl";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 5;
		lv2:symbol "output_level";
		lv2:name "Output Lvl";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 6;
		lv2:symbol "quality_scale";
		lv2:name "Quality";
		lv2:default 0.0;
		lv2:minimum 0.0;
		lv2:maximum 1.0;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 7;
		lv2:symbol "model_index";
		lv2:name "Model";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 199;
		lv2:portProperty lv2:integer;
		rdfs:comment "Rang du modele dans le dossier NAM Models";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 8;
		lv2:symbol "step_next";
		lv2:name "Next";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Modele suivant";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 9;
		lv2:symbol "step_prev";
		lv2:name "Prev";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Modele precedent";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 10;
		lv2:symbol "rescan";
		lv2:name "Rescan";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Relire le dossier des modeles";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 11;
		lv2:symbol "model_count";
		lv2:name "Count";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 200;
		lv2:portProperty lv2:integer;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 12;
		lv2:symbol "current_index";
		lv2:name "Current";
		lv2:default -1;
		lv2:minimum -1;
		lv2:maximum 199;
		lv2:portProperty lv2:integer;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 13;
		lv2:symbol "load_status";
		lv2:name "Status";
		lv2:default 0;
		lv2:minimum -1;
		lv2:maximum 2;
		lv2:portProperty lv2:integer;
		rdfs:comment "-1 echec, 0 rien, 1 en cours, 2 charge";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 14;
		lv2:symbol "browse";
		lv2:name "Browse";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Parcourir SANS charger";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 15;
		lv2:symbol "action";
		lv2:name "Load";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le modele parcouru";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 16;
		lv2:symbol "browse_index";
		lv2:name "Browsing";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 199;
		lv2:portProperty lv2:integer;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 17;
		lv2:symbol "active_fav";
		lv2:name "Active Fav";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 10;
		lv2:portProperty lv2:integer;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 18;
		lv2:symbol "fav_1";
		lv2:name "Fav 1";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 1";
		pg:group <@NAM_LV2_ID@#groupe1>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 19;
		lv2:symbol "fav_2";
		lv2:name "Fav 2";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 2";
		pg:group <@NAM_LV2_ID@#groupe2>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 20;
		lv2:symbol "fav_3";
		lv2:name "Fav 3";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 3";
		pg:group <@NAM_LV2_ID@#groupe3>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 21;
		lv2:symbol "fav_4";
		lv2:name "Fav 4";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 4";
		pg:group <@NAM_LV2_ID@#groupe4>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 22;
		lv2:symbol "fav_5";
		lv2:name "Fav 5";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 5";
		pg:group <@NAM_LV2_ID@#groupe5>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 23;
		lv2:symbol "fav_6";
		lv2:name "Fav 6";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 6";
		pg:group <@NAM_LV2_ID@#groupe6>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 24;
		lv2:symbol "fav_7";
		lv2:name "Fav 7";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 7";
		pg:group <@NAM_LV2_ID@#groupe7>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 25;
		lv2:symbol "fav_8";
		lv2:name "Fav 8";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 8";
		pg:group <@NAM_LV2_ID@#groupe8>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 26;
		lv2:symbol "fav_9";
		lv2:name "Fav 9";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 9";
		pg:group <@NAM_LV2_ID@#groupe9>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 27;
		lv2:symbol "fav_10";
		lv2:name "Fav 10";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Charger le favori 10";
		pg:group <@NAM_LV2_ID@#groupe10>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 28;
		lv2:symbol "store_slot";
		lv2:name "Slot";
		lv2:default 1;
		lv2:minimum 1;
		lv2:maximum 10;
		lv2:portProperty lv2:integer;
		rdfs:comment "Emplacement vise par Store";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 29;
		lv2:symbol "store";
		lv2:name "Store";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Ranger le modele courant dans l'emplacement Slot";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 30;
		lv2:symbol "fav_gain";
		lv2:name "Gain";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain hors favori";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 31;
		lv2:symbol "applied_gain";
		lv2:name "Gain Applied";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 32;
		lv2:symbol "store_count";
		lv2:name "Stores";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 999;
		lv2:portProperty lv2:integer;
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 33;
		lv2:symbol "fav_browse";
		lv2:name "Fav Next";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:toggled, mod:preferMomentaryOnByDefault;
		rdfs:comment "Passer au favori non vide suivant";
		pg:group <@NAM_LV2_ID@#groupe0>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 34;
		lv2:symbol "fav_gain_1";
		lv2:name "Gain 1";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain du favori 1";
		pg:group <@NAM_LV2_ID@#groupe1>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 35;
		lv2:symbol "fav_gain_2";
		lv2:name "Gain 2";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain du favori 2";
		pg:group <@NAM_LV2_ID@#groupe2>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 36;
		lv2:symbol "fav_gain_3";
		lv2:name "Gain 3";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain du favori 3";
		pg:group <@NAM_LV2_ID@#groupe3>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 37;
		lv2:symbol "fav_gain_4";
		lv2:name "Gain 4";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain du favori 4";
		pg:group <@NAM_LV2_ID@#groupe4>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 38;
		lv2:symbol "fav_gain_5";
		lv2:name "Gain 5";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain du favori 5";
		pg:group <@NAM_LV2_ID@#groupe5>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 39;
		lv2:symbol "fav_gain_6";
		lv2:name "Gain 6";
		lv2:default 0.0;
		lv2:minimum -20.0;
		lv2:maximum 20.0;
		units:unit units:db;
		rdfs:comment "Gain du favori 6";
		pg:group <@NAM_LV2_ID@#groupe6>;
	], [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 40;
		lv2:symbol "fav_gain_7";
